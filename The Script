/* 📄 InfoSo — paste into Chrome DevTools Console (F12 → Console) */
(() => {
  "use strict";
  const ID = "__infoso_panel__";
  const old = document.getElementById(ID);
  if (old) { try { old.__cleanup && old.__cleanup(); } catch {} old.remove(); }

  // ───────────────────────── helpers ─────────────────────────
  const safe = (fn, fb = "N/A") => {
    try { const v = fn(); return v === undefined || v === null || v === "" ? fb : v; } catch { return fb; }
  };
  const asafe = async (fn, fb = "N/A") => {
    try { const v = await fn(); return v === undefined || v === null ? fb : v; } catch { return fb; }
  };
  const fmtBytes = (n) => {
    if (!isFinite(n) || n == null) return "N/A";
    if (n < 1024) return n + " B";
    const u = ["KB", "MB", "GB"]; let i = -1;
    do { n /= 1024; i++; } while (n >= 1024 && i < u.length - 1);
    return n.toFixed(n < 10 ? 2 : 1) + " " + u[i];
  };
  const ms = (n) => (n > 0 ? Math.round(n) + " ms" : "N/A");
  const trunc = (s, n = 80) => { s = String(s); return s.length > n ? s.slice(0, n - 1) + "…" : s; };
  const lv = (v, level) => ({ v, level }); // level: good | warn | bad
  const S = (title, rows) => ({ title, rows });
  const L = (title, list) => ({ title, list });

  // ───────────────────────── live vitals ─────────────────────────
  const vitals = { fcp: null, lcp: null, cls: 0, longTasks: 0, longTaskTime: 0 };
  const observers = [];
  const observe = (type, cb) => {
    try {
      const o = new PerformanceObserver((l) => l.getEntries().forEach(cb));
      o.observe({ type, buffered: true });
      observers.push(o);
    } catch {}
  };
  observe("paint", (e) => { if (e.name === "first-contentful-paint") vitals.fcp = e.startTime; });
  observe("largest-contentful-paint", (e) => { vitals.lcp = e.startTime; });
  observe("layout-shift", (e) => { if (!e.hadRecentInput) vitals.cls += e.value; });
  observe("longtask", (e) => { vitals.longTasks++; vitals.longTaskTime += e.duration; });

  // ───────────────────────── tech detection ─────────────────────────
  const detectTech = (scriptSrcs, sheetHrefs) => {
    const d = document, w = window, found = [];
    const add = (name, ver) => found.push(ver ? `${name} ${ver}` : name);
    const srcHas = (re) => scriptSrcs.some((s) => re.test(s)) || sheetHrefs.some((s) => re.test(s));
    const root = d.getElementById("root") || d.getElementById("app") || d.getElementById("__next");

    if (w.React || d.querySelector("[data-reactroot]") || (root && Object.keys(root).some((k) => k.startsWith("__reactContainer") || k.startsWith("_reactRoot")))) add("React", safe(() => w.React.version, ""));
    if (w.__NEXT_DATA__ || d.getElementById("__next")) add("Next.js");
    if (w.Vue || w.__VUE__ || d.querySelector("[data-v-app]")) add("Vue", safe(() => w.Vue.version, ""));
    if (w.__NUXT__ || w.$nuxt) add("Nuxt");
    if (w.ng || d.querySelector("[ng-version]")) add("Angular", d.querySelector("[ng-version]")?.getAttribute("ng-version") || "");
    if (w.angular) add("AngularJS", safe(() => w.angular.version.full, ""));
    if (d.querySelector('[class*="svelte-"]')) add("Svelte");
    if (w.Alpine) add("Alpine.js", safe(() => w.Alpine.version, ""));
    if (w.htmx) add("htmx");
    if (d.getElementById("___gatsby")) add("Gatsby");
    if (w.jQuery) add("jQuery", safe(() => w.jQuery.fn.jquery, ""));
    if (w._ && w._.VERSION) add("Lodash", w._.VERSION);
    if (w.THREE) add("Three.js", safe(() => w.THREE.REVISION, ""));
    if (w.bootstrap || srcHas(/bootstrap/i)) add("Bootstrap");
    if (srcHas(/tailwind/i)) add("Tailwind CSS");
    if (srcHas(/font-?awesome|fontawesome/i)) add("Font Awesome");
    if (w.Shopify) add("Shopify");
    if (d.querySelector('meta[name="generator"][content*="WordPress" i]') || srcHas(/wp-content|wp-includes/i)) add("WordPress");
    if (w.Drupal) add("Drupal");
    if (w.wixBiSession || srcHas(/wixstatic/i)) add("Wix");
    if (srcHas(/squarespace/i)) add("Squarespace");
    if (w.gtag || w.ga || w.dataLayer || srcHas(/google-analytics|googletagmanager/i)) add("Google Analytics / GTM");
    if (srcHas(/connect\.facebook\.net|fbevents/i)) add("Facebook Pixel");
    if (srcHas(/cloudflare/i)) add("Cloudflare (scripts)");
    if (srcHas(/stripe\.com/i)) add("Stripe");
    if (srcHas(/recaptcha|hcaptcha/i)) add("CAPTCHA");
    const gen = d.querySelector('meta[name="generator"]')?.content;
    if (gen) add("Generator: " + gen);
    return found;
  };

  // ───────────────────────── headers cache ─────────────────────────
  let headersCache = null;
  let headersError = null;
  const fetchHeaders = async () => {
    headersError = null;
    try {
      const r = await fetch(location.href, { method: "HEAD", cache: "no-store", credentials: "same-origin" });
      headersCache = { status: `${r.status} ${r.statusText}`.trim(), headers: Object.fromEntries(r.headers.entries()) };
    } catch (e) {
      headersError = String(e && e.message ? e.message : e);
    }
    await render();
  };

  // ───────────────────────── data collection ─────────────────────────
  const collect = async () => {
    const d = document;
    const nav = performance.getEntriesByType("navigation")[0];
    const res = performance.getEntriesByType("resource");
    const all = [...d.getElementsByTagName("*")];
    const meta = (n) => d.querySelector(`meta[name="${n}" i], meta[property="${n}" i]`)?.content?.trim() || null;
    const na = (v) => (v === null || v === undefined || v === "" ? "N/A" : v);
    const hostname = location.hostname;
    const hostOf = (u) => safe(() => new URL(u, location.href).hostname, "");

    // DOM depth
    const depthMap = new Map(); let maxDepth = 0;
    for (const el of all) {
      const p = el.parentElement;
      const dep = p ? (depthMap.get(p) || 0) + 1 : 1;
      depthMap.set(el, dep);
      if (dep > maxDepth) maxDepth = dep;
    }

    const words = (d.body?.innerText || "").trim().split(/\s+/).filter(Boolean).length;
    const scripts = [...d.scripts];
    const scriptSrcs = scripts.map((s) => s.src).filter(Boolean);
    const sheetHrefs = [...d.querySelectorAll('link[rel~="stylesheet" i]')].map((l) => l.href).filter(Boolean);
    const inlineScripts = scripts.filter((s) => !s.src).length;
    const inlineStyles = d.querySelectorAll("style").length;

    // Resources
    const groups = {};
    res.forEach((r) => {
      const t = r.initiatorType || "other";
      const g = (groups[t] = groups[t] || { n: 0, size: 0 });
      g.n++; g.size += r.transferSize || 0;
    });
    const totalTransfer = res.reduce((a, r) => a + (r.transferSize || 0), 0) + (nav?.transferSize || 0);
    const resDomains = {};
    res.forEach((r) => { const h = hostOf(r.name); if (h) resDomains[h] = (resDomains[h] || 0) + 1; });
    const domainList = Object.entries(resDomains).sort((a, b) => b[1] - a[1]);
    const externalDomains = domainList.filter(([h]) => h !== hostname);
    const slowest = [...res].sort((a, b) => b.duration - a.duration).slice(0, 8)
      .map((r) => `${Math.round(r.duration)} ms — ${trunc(r.name, 70)}`);
    const biggest = [...res].filter((r) => r.transferSize).sort((a, b) => b.transferSize - a.transferSize).slice(0, 8)
      .map((r) => `${fmtBytes(r.transferSize)} — ${trunc(r.name, 70)}`);

    // Links
    const links = [...d.links];
    let internal = 0, external = 0, mail = 0, tel = 0, nofollow = 0, blank = 0, unsafeBlank = 0, empty = 0;
    const extHosts = {}; const emails = new Set(); const phones = new Set();
    const socialRe = /(twitter\.com|x\.com|facebook\.com|instagram\.com|linkedin\.com|youtube\.com|youtu\.be|github\.com|tiktok\.com|discord\.(gg|com)|reddit\.com|twitch\.tv|t\.me)/i;
    const social = new Set();
    links.forEach((a) => {
      const href = (a.getAttribute("href") || "").trim();
      if (a.protocol === "mailto:") { mail++; emails.add(href.replace(/^mailto:/i, "").split("?")[0]); return; }
      if (a.protocol === "tel:") { tel++; phones.add(href.replace(/^tel:/i, "")); return; }
      if (!href || href === "#") empty++;
      if (a.hostname && a.hostname === hostname) internal++;
      else if (a.hostname) { external++; extHosts[a.hostname] = (extHosts[a.hostname] || 0) + 1; if (socialRe.test(a.hostname)) social.add(a.href); }
      if (/nofollow/i.test(a.rel)) nofollow++;
      if (a.target === "_blank") { blank++; if (!/noopener|noreferrer/i.test(a.rel)) unsafeBlank++; }
    });

    // Images
    const imgs = [...d.images];
    const noAlt = imgs.filter((i) => !i.hasAttribute("alt"));
    const lazy = imgs.filter((i) => i.loading === "lazy").length;
    const bigImgs = imgs.filter((i) => i.naturalWidth)
      .sort((a, b) => b.naturalWidth * b.naturalHeight - a.naturalWidth * a.naturalHeight).slice(0, 5)
      .map((i) => `${i.naturalWidth}×${i.naturalHeight} — ${trunc(i.currentSrc || i.src, 70)}`);

    // Headings
    const hs = [...d.querySelectorAll("h1,h2,h3,h4,h5,h6")];
    const h1count = hs.filter((x) => x.tagName === "H1").length;
    const outline = hs.slice(0, 80).map((x) => "  ".repeat(+x.tagName[1] - 1) + x.tagName + "  " + trunc(x.textContent.trim().replace(/\s+/g, " "), 70));

    // Forms
    const forms = [...d.forms].map((f) => `${(f.method || "get").toUpperCase()} ${trunc(f.getAttribute("action") || "(same page)", 50)} — ${f.elements.length} fields`);
    const pwInputs = d.querySelectorAll('input[type="password"]');

    // Storage
    const lsKeys = safe(() => Object.keys(localStorage), null);
    const ssKeys = safe(() => Object.keys(sessionStorage), null);
    const sizeOf = (store, keys) => keys ? keys.map((k) => `${k}  (${fmtBytes((k.length + (store.getItem(k) || "").length) * 2)})`) : [];
    const cookies = d.cookie ? d.cookie.split(";").map((c) => c.trim()).filter(Boolean).map((c) => { const i = c.indexOf("="); return `${c.slice(0, i)} = ${trunc(c.slice(i + 1), 40)}`; }) : [];
    const idb = await asafe(async () => (await indexedDB.databases()).map((x) => `${x.name} (v${x.version})`), []);
    const sws = await asafe(async () => (await navigator.serviceWorker.getRegistrations()).map((r) => r.scope), []);
    const cacheNames = await asafe(async () => await caches.keys(), []);
    const quota = await asafe(async () => { const e = await navigator.storage.estimate(); return `${fmtBytes(e.usage)} of ${fmtBytes(e.quota)}`; });

    // Permissions
    const perms = {};
    for (const p of ["geolocation", "notifications", "camera", "microphone", "clipboard-write", "persistent-storage"]) {
      perms[p] = await asafe(async () => (await navigator.permissions.query({ name: p })).state, "Unsupported");
    }

    // Device
    const conn = navigator.connection;
    const uad = navigator.userAgentData;
    const battery = await asafe(async () => { const b = await navigator.getBattery(); return `${Math.round(b.level * 100)}%${b.charging ? " (charging)" : ""}`; });
    const gpu = safe(() => {
      const gl = document.createElement("canvas").getContext("webgl");
      const ext = gl.getExtension("WEBGL_debug_renderer_info");
      return gl.getParameter(ext.UNMASKED_RENDERER_WEBGL);
    });
    const mem = performance.memory;

    // Mixed content
    const mixed = location.protocol === "https:" ? res.filter((r) => r.name.startsWith("http://")).length : 0;
    const iframes = [...d.querySelectorAll("iframe")].map((f) => `${trunc(f.src || "(about:blank)", 60)}  [sandbox: ${f.hasAttribute("sandbox") ? f.getAttribute("sandbox") || "all" : "none"}]`);

    const tech = detectTech(scriptSrcs, sheetHrefs);
    const fonts = safe(() => [...new Set([...d.fonts].map((f) => f.family.replace(/["']/g, "")))], []);
    const faviconList = [...d.querySelectorAll('link[rel~="icon" i]')].map((l) => l.href);

    // ───────── tabs ─────────
    const tabs = {};

    tabs["Overview"] = [
      S("General", {
        "URL": location.href,
        "Origin": location.origin,
        "Domain": hostname,
        "Protocol": location.protocol,
        "Port": location.port || "(default)",
        "Path": location.pathname,
        "Query": location.search || "None",
        "Hash": location.hash || "None",
        "Title": na(d.title) + (d.title ? `  (${d.title.length} chars)` : ""),
        "Language": na(d.documentElement.lang),
        "Direction": d.dir || getComputedStyle(d.documentElement).direction,
        "Charset": d.characterSet,
        "Doctype": d.doctype ? `<!DOCTYPE ${d.doctype.name}>` : lv("None (quirks mode)", "warn"),
        "Render mode": d.compatMode,
        "Ready state": d.readyState,
        "Visibility": d.visibilityState,
        "Last modified": d.lastModified,
        "Referrer": d.referrer || "None",
      }),
      S("SEO & Meta", {
        "Description": meta("description") ? `${meta("description")}  (${meta("description").length} chars)` : lv("Missing", "warn"),
        "Keywords": na(meta("keywords")),
        "Robots": na(meta("robots")),
        "Canonical": d.querySelector('link[rel="canonical" i]')?.href || lv("Missing", "warn"),
        "Viewport": meta("viewport") || lv("Missing", "warn"),
        "Theme color": na(meta("theme-color")),
        "Author": na(meta("author")),
        "Generator": na(meta("generator")),
        "Manifest": d.querySelector('link[rel="manifest" i]')?.href || "None",
        "Hreflang tags": d.querySelectorAll("link[hreflang]").length,
        "H1 count": h1count === 1 ? lv("1 (good)", "good") : lv(String(h1count), "warn"),
      }),
      S("Social / Open Graph", {
        "og:title": na(meta("og:title")),
        "og:description": na(meta("og:description")),
        "og:image": na(meta("og:image")),
        "og:type": na(meta("og:type")),
        "og:site_name": na(meta("og:site_name")),
        "twitter:card": na(meta("twitter:card")),
        "twitter:site": na(meta("twitter:site")),
      }),
      L("Favicons", faviconList.length ? faviconList : [location.origin + "/favicon.ico  (default guess)"]),
    ];

    tabs["Tech"] = [
      L("Detected technologies", tech.length ? tech : ["Nothing obvious detected"]),
      S("Content counts", {
        "DOM elements": all.length,
        "Max DOM depth": maxDepth > 32 ? lv(maxDepth + " (deep)", "warn") : maxDepth,
        "Word count": words,
        "Reading time": Math.max(1, Math.round(words / 220)) + " min",
        "Links": d.links.length,
        "Images": d.images.length,
        "Scripts": `${scripts.length} (${inlineScripts} inline)`,
        "Stylesheets": `${sheetHrefs.length} linked, ${inlineStyles} inline`,
        "Forms / inputs / buttons": `${d.forms.length} / ${d.querySelectorAll("input,textarea,select").length} / ${d.querySelectorAll("button").length}`,
        "Tables": d.querySelectorAll("table").length,
        "Video / audio": `${d.querySelectorAll("video").length} / ${d.querySelectorAll("audio").length}`,
        "Canvas / SVG": `${d.querySelectorAll("canvas").length} / ${d.querySelectorAll("svg").length}`,
        "iFrames": iframes.length,
      }),
      L("External scripts", scriptSrcs.map((s) => trunc(s, 90))),
      L("Stylesheets", sheetHrefs.map((s) => trunc(s, 90))),
      L("Fonts used", fonts),
    ];

    const t = nav || {};
    tabs["Perf"] = [
      S("Navigation timing", {
        "Navigation type": na(t.type),
        "HTTP protocol": na(t.nextHopProtocol),
        "Redirects": t.redirectCount ?? "N/A",
        "DNS lookup": ms(t.domainLookupEnd - t.domainLookupStart),
        "TCP connect": ms(t.connectEnd - t.connectStart),
        "TLS handshake": t.secureConnectionStart > 0 ? ms(t.connectEnd - t.secureConnectionStart) : "N/A",
        "TTFB": ms(t.responseStart),
        "Download": ms(t.responseEnd - t.responseStart),
        "DOM interactive": ms(t.domInteractive),
        "DOMContentLoaded": ms(t.domContentLoadedEventEnd),
        "Load event": t.loadEventEnd > 0 ? ms(t.loadEventEnd) : "Still loading",
        "Document size": `${fmtBytes(t.encodedBodySize)} (${fmtBytes(t.decodedBodySize)} decoded)`,
      }),
      S("Core Web Vitals (so far)", {
        "First Contentful Paint": vitals.fcp == null ? "N/A" : lv(ms(vitals.fcp), vitals.fcp < 1800 ? "good" : vitals.fcp < 3000 ? "warn" : "bad"),
        "Largest Contentful Paint": vitals.lcp == null ? "N/A" : lv(ms(vitals.lcp), vitals.lcp < 2500 ? "good" : vitals.lcp < 4000 ? "warn" : "bad"),
        "Cumulative Layout Shift": lv(vitals.cls.toFixed(3), vitals.cls < 0.1 ? "good" : vitals.cls < 0.25 ? "warn" : "bad"),
        "Long tasks (>50ms)": `${vitals.longTasks} (${Math.round(vitals.longTaskTime)} ms total)`,
      }),
      S("Network", {
        "Requests": res.length + 1,
        "Total transferred": fmtBytes(totalTransfer) + (totalTransfer === 0 ? " (cross-origin sizes hidden)" : ""),
        "Domains contacted": domainList.length,
        "External domains": externalDomains.length,
      }),
      S("By type", Object.fromEntries(Object.entries(groups).sort((a, b) => b[1].n - a[1].n).map(([k, g]) => [k, `${g.n} req · ${fmtBytes(g.size)}`]))),
      L("Slowest resources", slowest),
      L("Largest resources", biggest),
      S("JS memory (Chrome)", mem ? {
        "Used heap": fmtBytes(mem.usedJSHeapSize),
        "Total heap": fmtBytes(mem.totalJSHeapSize),
        "Heap limit": fmtBytes(mem.jsHeapSizeLimit),
      } : { "Heap": "Not available" }),
    ];

    tabs["Storage"] = [
      S("Summary", {
        "Cookies (JS-visible)": cookies.length,
        "localStorage items": lsKeys ? lsKeys.length : lv("Blocked", "warn"),
        "sessionStorage items": ssKeys ? ssKeys.length : lv("Blocked", "warn"),
        "IndexedDB databases": idb.length,
        "Service workers": sws.length,
        "Cache Storage": cacheNames.length,
        "Storage used": quota,
      }),
      L("Cookies", cookies),
      L("localStorage keys", sizeOf(safe(() => localStorage, null), lsKeys)),
      L("sessionStorage keys", sizeOf(safe(() => sessionStorage, null), ssKeys)),
      L("IndexedDB", idb),
      L("Service workers", sws),
      L("Cache names", cacheNames),
    ];

    tabs["Page"] = [
      L("Heading outline", outline.length ? outline : ["No headings found"]),
      S("Links", {
        "Total": links.length,
        "Internal": internal,
        "External": external,
        "mailto / tel": `${mail} / ${tel}`,
        "nofollow": nofollow,
        "Open in new tab": blank,
        "Empty or '#' links": empty > 0 ? lv(String(empty), "warn") : 0,
      }),
      L("Top external link domains", Object.entries(extHosts).sort((a, b) => b[1] - a[1]).slice(0, 12).map(([h, n]) => `${h}  ×${n}`)),
      L("Social links", [...social].slice(0, 15)),
      L("Emails found", [...emails]),
      L("Phone numbers found", [...phones]),
      S("Images", {
        "Total": imgs.length,
        "Missing alt attribute": noAlt.length ? lv(String(noAlt.length), "warn") : lv("0", "good"),
        "Lazy-loaded": lazy,
      }),
      L("Largest images (natural size)", bigImgs),
      L("Images missing alt", noAlt.slice(0, 10).map((i) => trunc(i.currentSrc || i.src || "(no src)", 90))),
      L("Forms", forms),
    ];

    tabs["Security"] = [
      S("Connection", {
        "HTTPS": location.protocol === "https:" ? lv("Yes", "good") : lv("No", "bad"),
        "Secure context": window.isSecureContext ? lv("Yes", "good") : lv("No", "warn"),
        "Mixed content requests": mixed ? lv(String(mixed), "bad") : lv("0", "good"),
        "Cross-origin isolated": window.crossOriginIsolated ? "Yes" : "No",
        "CSP via <meta>": d.querySelector('meta[http-equiv="Content-Security-Policy" i]') ? "Present" : "None (may still be in HTTP headers)",
        "Referrer policy (meta)": na(meta("referrer")),
        "Password fields": pwInputs.length,
        "target=_blank w/o noopener": unsafeBlank ? lv(String(unsafeBlank), "warn") : lv("0", "good"),
        "External domains contacted": externalDomains.length,
      }),
      S("Permissions", perms),
      L("iFrames", iframes),
      L("Top external domains", externalDomains.slice(0, 15).map(([h, n]) => `${h}  ×${n}`)),
    ];

    tabs["Device"] = [
      S("Browser", {
        "User agent": navigator.userAgent,
        "Brands": uad ? uad.brands.map((b) => `${b.brand} ${b.version}`).join(", ") : "N/A",
        "Platform": (uad && uad.platform) || navigator.platform,
        "Mobile": uad ? String(uad.mobile) : "N/A",
        "Languages": (navigator.languages || [navigator.language]).join(", "),
        "Timezone": safe(() => Intl.DateTimeFormat().resolvedOptions().timeZone),
        "Local time": new Date().toString(),
        "Cookies enabled": navigator.cookieEnabled,
        "Do Not Track": na(navigator.doNotTrack),
        "PDF viewer": navigator.pdfViewerEnabled ?? "N/A",
      }),
      S("Hardware & display", {
        "CPU cores": na(navigator.hardwareConcurrency),
        "Device memory": navigator.deviceMemory ? navigator.deviceMemory + " GB (approx)" : "N/A",
        "GPU": gpu,
        "Screen": `${screen.width}×${screen.height}`,
        "Available screen": `${screen.availWidth}×${screen.availHeight}`,
        "Viewport": `${innerWidth}×${innerHeight}`,
        "Pixel ratio": devicePixelRatio,
        "Color depth": screen.colorDepth + "-bit",
        "Orientation": safe(() => screen.orientation.type),
        "Touch points": navigator.maxTouchPoints,
        "Battery": battery,
      }),
      S("Network & preferences", {
        "Online": navigator.onLine,
        "Connection type": conn ? na(conn.effectiveType) : "N/A",
        "Downlink": conn?.downlink ? conn.downlink + " Mbps" : "N/A",
        "RTT": conn?.rtt ? conn.rtt + " ms" : "N/A",
        "Data saver": conn ? String(conn.saveData) : "N/A",
        "Prefers dark mode": matchMedia("(prefers-color-scheme: dark)").matches,
        "Prefers reduced motion": matchMedia("(prefers-reduced-motion: reduce)").matches,
      }),
    ];

    // Headers tab
    const wantHeaders = ["content-security-policy", "strict-transport-security", "x-frame-options", "x-content-type-options", "referrer-policy", "permissions-policy"];
    const headerSecs = [];
    if (headersCache) {
      const hd = headersCache.headers;
      headerSecs.push(S("Response", { "Status": headersCache.status, "Headers": Object.keys(hd).length }));
      headerSecs.push(S("All headers", Object.fromEntries(Object.entries(hd).map(([k, v]) => [k, trunc(v, 160)]))));
      headerSecs.push(S("Security header check", Object.fromEntries(wantHeaders.map((k) => [k, hd[k] ? lv("✓ present", "good") : lv("✗ missing", "warn")]))));
    } else {
      headerSecs.push(S("Headers", { "Status": headersError ? lv("Failed: " + headersError, "bad") : "Not fetched yet — click below" }));
    }
    headerSecs.push({ title: "Actions", buttons: [{ label: headersCache ? "Re-fetch headers" : "Fetch headers (HEAD request)", fn: fetchHeaders }] });
    tabs["Headers"] = headerSecs;

    // Tools tab
    tabs["Tools"] = [
      { title: "Page overlays", toggles: toggles },
      {
        title: "Actions", buttons: [
          { label: "Copy JSON", fn: () => copy(JSON.stringify(toPlain(tabData), null, 2)) },
          { label: "Download JSON", fn: downloadJSON },
          { label: "Copy all links", fn: () => copy([...document.links].map((a) => a.href).join("\n")) },
          { label: "Copy image URLs", fn: () => copy([...document.images].map((i) => i.currentSrc || i.src).join("\n")) },
          { label: "Copy page text", fn: () => copy(document.body?.innerText || "") },
          { label: "Log to console", fn: () => { console.log("InfoSo data:", toPlain(tabData)); flash("Logged"); } },
          { label: "Scroll to top", fn: () => scrollTo({ top: 0, behavior: "smooth" }) },
          { label: "Scroll to bottom", fn: () => scrollTo({ top: document.documentElement.scrollHeight, behavior: "smooth" }) },
        ],
      },
    ];

    return tabs;
  };

  // ───────────────────────── UI plumbing ─────────────────────────
  const h = (tag, props = {}, ...kids) => {
    const e = document.createElement(tag);
    for (const [k, v] of Object.entries(props)) {
      if (k === "class") e.className = v;
      else if (k === "text") e.textContent = v;
      else if (k.startsWith("on")) e.addEventListener(k.slice(2), v);
      else e.setAttribute(k, v);
    }
    kids.flat().forEach((c) => e.append(c));
    return e;
  };

  const toPlain = (tabs) => {
    const out = {};
    for (const [tab, secs] of Object.entries(tabs || {})) {
      out[tab] = {};
      for (const s of secs) {
        if (s.rows) out[tab][s.title] = Object.fromEntries(Object.entries(s.rows).map(([k, v]) => [k, v && typeof v === "object" ? v.v : v]));
        else if (s.list) out[tab][s.title] = s.list;
      }
    }
    return out;
  };

  // CSS overlay toggles (adoptedStyleSheets are not blocked by page CSP)
  const sheets = {};
  const cssToggle = (label, css) => ({
    label,
    get: () => !!sheets[label],
    set: (on) => {
      try {
        if (on) {
          const s = new CSSStyleSheet(); s.replaceSync(css);
          sheets[label] = s;
          document.adoptedStyleSheets = [...document.adoptedStyleSheets, s];
        } else {
          const s = sheets[label];
          document.adoptedStyleSheets = document.adoptedStyleSheets.filter((x) => x !== s);
          delete sheets[label];
        }
      } catch { flash("Blocked by page"); }
    },
  });
  const toggles = [
    cssToggle("Outline all elements", `*{outline:1px solid rgba(255,70,70,.55)!important}`),
    cssToggle("Highlight images missing alt", `img:not([alt]){outline:4px solid #ff2d55!important;outline-offset:-4px!important}`),
    cssToggle("Highlight links", `a[href]{background:rgba(255,235,59,.55)!important;outline:1px solid #f9a825!important}`),
    cssToggle("Freeze animations", `*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}`),
    cssToggle("Hide images", `img,picture,video,svg{visibility:hidden!important}`),
    cssToggle("Invert page colors", `html{filter:invert(1) hue-rotate(180deg)!important}img,video,picture{filter:invert(1) hue-rotate(180deg)!important}#${ID}{filter:invert(1) hue-rotate(180deg)!important}`),
    {
      label: "Edit page (designMode)",
      get: () => document.designMode === "on",
      set: (on) => { document.designMode = on ? "on" : "off"; },
    },
  ];

  const downloadJSON = () => {
    try {
      const blob = new Blob([JSON.stringify(toPlain(tabData), null, 2)], { type: "application/json" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `infoso-${location.hostname || "page"}.json`;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 2000);
      flash("Downloaded");
    } catch { flash("Download blocked"); }
  };

  const copy = async (text) => {
    try { await navigator.clipboard.writeText(text); }
    catch {
      const ta = document.createElement("textarea");
      ta.value = text; ta.style.cssText = "position:fixed;opacity:0";
      document.body.appendChild(ta); ta.select();
      try { document.execCommand("copy"); } catch {}
      ta.remove();
    }
    flash("Copied ✓");
  };

  // ───────────────────────── panel ─────────────────────────
  const host = document.createElement("div");
  host.id = ID;
  host.style.cssText = "position:fixed;top:20px;left:20px;z-index:2147483647;";
  const root = host.attachShadow({ mode: "open" });

  const css = `
    * { box-sizing: border-box; }
    .panel { display: flex; flex-direction: column; width: 430px; height: 580px; min-width: 300px; min-height: 120px;
      max-width: calc(100vw - 8px); max-height: calc(100vh - 8px); resize: both; overflow: hidden;
      background: #14171c; color: #e6e9ef; font: 12px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      border: 1px solid #2c323c; border-radius: 12px; box-shadow: 0 12px 36px rgba(0,0,0,.55); }
    .panel.min { height: auto !important; min-height: 0; resize: none; }
    .panel.min .tabs, .panel.min .search, .panel.min .body, .panel.min .foot { display: none; }
    .bar { display: flex; align-items: center; gap: 6px; padding: 8px 10px; background: #1d222a; cursor: grab;
      user-select: none; touch-action: none; border-bottom: 1px solid #2c323c; flex: none; }
    .bar.dragging { cursor: grabbing; }
    .title { flex: 1; font-weight: 700; font-size: 14px; letter-spacing: .02em; }
    button { font: inherit; color: inherit; cursor: pointer; }
    .ib { background: #2a303a; border: 0; border-radius: 6px; width: 24px; height: 24px; font-size: 13px; line-height: 1; padding: 0; }
    .ib:hover { background: #3a4250; }
    .ib.close:hover { background: #c0392b; }
    .tabs { display: flex; gap: 2px; padding: 6px 8px 0; overflow-x: auto; flex: none; background: #181c22; scrollbar-width: thin; }
    .tab { background: transparent; border: 0; border-bottom: 2px solid transparent; padding: 5px 9px; color: #8b94a5; white-space: nowrap; }
    .tab:hover { color: #e6e9ef; }
    .tab.on { color: #4ea1ff; border-bottom-color: #4ea1ff; font-weight: 600; }
    .search { padding: 6px 10px; flex: none; background: #181c22; border-bottom: 1px solid #2c323c; }
    .search input { width: 100%; background: #0f1216; border: 1px solid #2c323c; color: #e6e9ef; border-radius: 6px; padding: 5px 8px; font: inherit; outline: none; }
    .search input:focus { border-color: #4ea1ff; }
    .body { flex: 1; overflow: auto; padding: 2px 10px 10px; min-height: 0; }
    h4 { margin: 12px 0 4px; font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: #4ea1ff; }
    .row { display: grid; grid-template-columns: 125px 1fr; gap: 8px; padding: 3px 0; border-bottom: 1px solid #1f242c; }
    .k { color: #8b94a5; }
    .v, .li { word-break: break-word; overflow-wrap: anywhere; cursor: copy; }
    .v:hover, .li:hover { background: #1d2530; }
    .li { padding: 2px 4px; border-bottom: 1px solid #1f242c; white-space: pre-wrap; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 11px; }
    .good { color: #4cd964; } .warn { color: #ffb020; } .bad { color: #ff5c5c; }
    .empty { color: #6b7385; font-style: italic; padding: 2px 0; }
    .tg { display: flex; align-items: center; gap: 8px; padding: 4px 0; cursor: pointer; }
    .btns { display: flex; flex-wrap: wrap; gap: 6px; padding: 4px 0; }
    .btn { background: #2a303a; border: 1px solid #3a4250; border-radius: 6px; padding: 5px 10px; }
    .btn:hover { background: #3a4250; }
    .foot { display: flex; align-items: center; gap: 10px; padding: 5px 10px; background: #1d222a; border-top: 1px solid #2c323c;
      color: #8b94a5; font-size: 11px; flex: none; }
    .foot .grow { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .foot label { display: flex; align-items: center; gap: 4px; cursor: pointer; }
    .foot input[type=range] { width: 60px; }
  `;
  try { const sh = new CSSStyleSheet(); sh.replaceSync(css); root.adoptedStyleSheets = [sh]; }
  catch { const st = document.createElement("style"); st.textContent = css; root.append(st); }

  const panel = h("div", { class: "panel" });
  const title = h("span", { class: "title", text: "📄 InfoSo" });
  const refreshBtn = h("button", { class: "ib", title: "Refresh", text: "⟳" });
  const copyBtn = h("button", { class: "ib", title: "Copy everything as JSON", text: "⧉" });
  const minBtn = h("button", { class: "ib", title: "Minimize", text: "–" });
  const closeBtn = h("button", { class: "ib close", title: "Close", text: "✕" });
  const bar = h("div", { class: "bar" }, title, refreshBtn, copyBtn, minBtn, closeBtn);

  const tabsEl = h("div", { class: "tabs" });
  const searchInput = h("input", { type: "text", placeholder: "Filter this tab…" });
  const searchWrap = h("div", { class: "search" }, searchInput);
  const body = h("div", { class: "body" });
  const statusEl = h("span", { class: "grow", text: "Loading…" });
  const fpsEl = h("span", { text: "-- FPS" });
  const liveBox = h("input", { type: "checkbox" });
  const liveLabel = h("label", { title: "Auto-refresh every 3 seconds" }, liveBox, "Live");
  const opacity = h("input", { type: "range", min: "40", max: "100", value: "100", title: "Panel opacity" });
  const foot = h("div", { class: "foot" }, statusEl, fpsEl, liveLabel, opacity);

  panel.append(bar, tabsEl, searchWrap, body, foot);
  root.append(panel);
  document.documentElement.appendChild(host);

  let flashTimer;
  function flash(msg) {
    statusEl.textContent = msg;
    clearTimeout(flashTimer);
    flashTimer = setTimeout(() => (statusEl.textContent = "Updated " + new Date().toLocaleTimeString()), 1500);
  }

  // ───────────────────────── render ─────────────────────────
  let tabData = {};
  let current = "Overview";
  let query = "";

  const draw = () => {
    const names = Object.keys(tabData);
    if (!names.includes(current)) current = names[0] || "Overview";
    tabsEl.replaceChildren(...names.map((n) => h("button", {
      class: "tab" + (n === current ? " on" : ""), text: n,
      onclick: () => { current = n; draw(); body.scrollTop = 0; },
    })));

    const st = body.scrollTop;
    const q = query.trim().toLowerCase();
    const frag = [];

    for (const sec of tabData[current] || []) {
      const secHit = q && sec.title.toLowerCase().includes(q);
      const parts = [];

      if (sec.rows) {
        for (const [k, raw] of Object.entries(sec.rows)) {
          const val = raw && typeof raw === "object" ? raw : { v: raw };
          const txt = String(val.v);
          if (q && !secHit && !(k + " " + txt).toLowerCase().includes(q)) continue;
          parts.push(h("div", { class: "row" },
            h("div", { class: "k", text: k }),
            h("div", { class: "v" + (val.level ? " " + val.level : ""), text: txt, title: "Click to copy", onclick: () => copy(txt) })));
        }
      }
      if (sec.list) {
        const items = sec.list.filter((x) => !q || secHit || String(x).toLowerCase().includes(q));
        if (!items.length && !q) parts.push(h("div", { class: "empty", text: "None" }));
        items.forEach((x) => parts.push(h("div", { class: "li", text: String(x), title: "Click to copy", onclick: () => copy(String(x).trim()) })));
      }
      if (sec.toggles && !q) {
        sec.toggles.forEach((t) => {
          const cb = h("input", { type: "checkbox" });
          cb.checked = t.get();
          cb.addEventListener("change", () => t.set(cb.checked));
          parts.push(h("label", { class: "tg" }, cb, t.label));
        });
      }
      if (sec.buttons && !q) {
        parts.push(h("div", { class: "btns" }, sec.buttons.map((b) => h("button", { class: "btn", text: b.label, onclick: b.fn }))));
      }

      if (!parts.length) continue;
      frag.push(h("h4", { text: sec.title + (sec.list ? ` (${sec.list.length})` : "") }), ...parts);
    }
    if (!frag.length) frag.push(h("div", { class: "empty", text: q ? "No matches." : "Nothing to show." }));
    body.replaceChildren(...frag);
    body.scrollTop = st;
  };

  let rendering = false;
  async function render() {
    if (rendering) return;
    rendering = true;
    try { tabData = await collect(); }
    catch (e) { tabData = { Overview: [S("Error", { Message: String(e && e.message ? e.message : e) })] }; }
    rendering = false;
    draw();
    statusEl.textContent = "Updated " + new Date().toLocaleTimeString();
  }

  // ───────────────────────── events ─────────────────────────
  refreshBtn.onclick = render;
  copyBtn.onclick = () => copy(JSON.stringify(toPlain(tabData), null, 2));
  closeBtn.onclick = () => cleanup();
  minBtn.onclick = () => {
    panel.classList.toggle("min");
    minBtn.textContent = panel.classList.contains("min") ? "+" : "–";
  };
  searchInput.addEventListener("input", () => { query = searchInput.value; draw(); });
  opacity.addEventListener("input", () => { panel.style.opacity = String(opacity.value / 100); });

  let liveTimer = null;
  liveBox.addEventListener("change", () => {
    clearInterval(liveTimer);
    if (liveBox.checked) liveTimer = setInterval(render, 3000);
  });

  // Dragging
  let offX = 0, offY = 0, dragging = false;
  const clamp = () => {
    const r = host.getBoundingClientRect();
    host.style.left = Math.min(Math.max(0, r.left), Math.max(0, innerWidth - Math.min(r.width, innerWidth))) + "px";
    host.style.top = Math.min(Math.max(0, r.top), Math.max(0, innerHeight - 40)) + "px";
  };
  bar.addEventListener("pointerdown", (e) => {
    if (e.target.closest("button")) return;
    dragging = true;
    const r = host.getBoundingClientRect();
    offX = e.clientX - r.left; offY = e.clientY - r.top;
    bar.setPointerCapture(e.pointerId);
    bar.classList.add("dragging");
  });
  bar.addEventListener("pointermove", (e) => {
    if (!dragging) return;
    host.style.left = e.clientX - offX + "px";
    host.style.top = e.clientY - offY + "px";
    clamp();
  });
  const stopDrag = (e) => {
    dragging = false;
    bar.classList.remove("dragging");
    try { bar.releasePointerCapture(e.pointerId); } catch {}
  };
  bar.addEventListener("pointerup", stopDrag);
  bar.addEventListener("pointercancel", stopDrag);
  bar.addEventListener("dblclick", (e) => { if (!e.target.closest("button")) minBtn.click(); });
  addEventListener("resize", clamp);

  // Hotkey: Alt+Shift+I hides / shows the panel
  const onKey = (e) => {
    if (e.altKey && e.shiftKey && e.code === "KeyI") {
      host.style.display = host.style.display === "none" ? "" : "none";
    }
  };
  addEventListener("keydown", onKey, true);

  // FPS counter
  let frames = 0, last = performance.now(), raf = 0;
  const loop = (t) => {
    frames++;
    if (t - last >= 1000) { fpsEl.textContent = Math.round((frames * 1000) / (t - last)) + " FPS"; frames = 0; last = t; }
    raf = requestAnimationFrame(loop);
  };
  raf = requestAnimationFrame(loop);

  // Cleanup (also runs if you paste the script again)
  function cleanup() {
    clearInterval(liveTimer);
    clearTimeout(flashTimer);
    cancelAnimationFrame(raf);
    observers.forEach((o) => { try { o.disconnect(); } catch {} });
    removeEventListener("resize", clamp);
    removeEventListener("keydown", onKey, true);
    // undo any page overlays we added
    try {
      const ours = Object.values(sheets);
      document.adoptedStyleSheets = document.adoptedStyleSheets.filter((s) => !ours.includes(s));
      if (document.designMode === "on") document.designMode = "off";
    } catch {}
    host.remove();
  }
  host.__cleanup = cleanup;

  render();
})();
