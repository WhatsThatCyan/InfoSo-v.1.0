/* InfoSo v.1.2 🎃 Halloween Edition — paste into Chrome DevTools Console (F12 → Console) */
(() => {
  "use strict";
  const ID = "__infoso_panel__";
  const old = document.getElementById(ID);
  if (old) { try { old.__cleanup && old.__cleanup(); } catch {} old.remove(); }

  // ───────────────────────── helpers ─────────────────────────
  const safe = (fn, fb = "N/A") => {
    try { const v = fn(); return v === undefined || v === null || v === "" ? fb : v; } catch { return fb; }
  };
  const asafe = async (fn, fb = "N/A") => {
    try { const v = await fn(); return v === undefined || v === null ? fb : v; } catch { return fb; }
  };
  const fmtBytes = (n) => {
    if (!isFinite(n) || n == null) return "N/A";
    if (n < 1024) return n + " B";
    const u = ["KB", "MB", "GB"]; let i = -1;
    do { n /= 1024; i++; } while (n >= 1024 && i < u.length - 1);
    return n.toFixed(n < 10 ? 2 : 1) + " " + u[i];
  };
  const ms = (n) => (n > 0 ? Math.round(n) + " ms" : "N/A");
  const trunc = (s, n = 80) => { s = String(s); return s.length > n ? s.slice(0, n - 1) + "…" : s; };
  const lv = (v, level) => ({ v, level }); // level: good | warn | bad
  const S = (title, rows) => ({ title, rows });
  const L = (title, list) => ({ title, list });

  // ───────────────────────── live vitals ─────────────────────────
  const vitals = { fcp: null, lcp: null, cls: 0, longTasks: 0, longTaskTime: 0 };
  const observers = [];
  const observe = (type, cb) => {
    try {
      const o = new PerformanceObserver((l) => l.getEntries().forEach(cb));
      o.observe({ type, buffered: true });
      observers.push(o);
    } catch {}
  };
  observe("paint", (e) => { if (e.name === "first-contentful-paint") vitals.fcp = e.startTime; });
  observe("largest-contentful-paint", (e) => { vitals.lcp = e.startTime; });
  observe("layout-shift", (e) => { if (!e.hadRecentInput) vitals.cls += e.value; });
  observe("longtask", (e) => { vitals.longTasks++; vitals.longTaskTime += e.duration; });

  // ───────────────────────── tech detection ─────────────────────────
  const txtOf = (x) => (x && typeof x === "object" ? x.text : String(x));

  // CSS selector path for an element
  const cssPath = (el) => {
    if (!(el instanceof Element)) return "";
    const parts = [];
    while (el && el.nodeType === 1 && el !== document.documentElement) {
      let s = el.tagName.toLowerCase();
      if (el.id && document.querySelectorAll("#" + CSS.escape(el.id)).length === 1) { parts.unshift(s + "#" + CSS.escape(el.id)); break; }
      s += [...el.classList].slice(0, 2).map((c) => "." + CSS.escape(c)).join("");
      const sib = el.parentElement ? [...el.parentElement.children].filter((c) => c.tagName === el.tagName) : [];
      if (sib.length > 1) s += `:nth-of-type(${sib.indexOf(el) + 1})`;
      parts.unshift(s);
      el = el.parentElement;
    }
    return parts.join(" > ");
  };

  // Color helpers
  const rgbOf = (c) => { const m = String(c).match(/[\d.]+/g); return m && m.length >= 3 ? { r: +m[0], g: +m[1], b: +m[2], a: m[3] !== undefined ? +m[3] : 1 } : null; };
  const toHex = (c) => { const o = rgbOf(c); if (!o || o.a === 0) return null; return "#" + [o.r, o.g, o.b].map((n) => Math.round(n).toString(16).padStart(2, "0")).join(""); };
  const lum = ({ r, g, b }) => { const f = (v) => { v /= 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); }; return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b); };
  const effBg = (el) => { while (el) { const c = rgbOf(getComputedStyle(el).backgroundColor); if (c && c.a > 0.95) return c; el = el.parentElement; } return { r: 255, g: 255, b: 255, a: 1 }; };
  const contrastOf = (el) => {
    const fg = rgbOf(getComputedStyle(el).color); if (!fg) return null;
    const l1 = lum(fg), l2 = lum(effBg(el));
    return (Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05);
  };

  const strOf = (a) => {
    try {
      if (a instanceof Error) return a.message || String(a);
      if (a instanceof Element) return cssPath(a);
      if (typeof a === "object" && a !== null) return JSON.stringify(a);
      return String(a);
    } catch { return String(a); }
  };

  // Console / error capture (restored when the panel closes)
  const logs = [];
  const addLog = (type, msg) => {
    logs.push({ t: new Date().toLocaleTimeString(), type, msg: trunc(msg, 300) });
    if (logs.length > 200) logs.shift();
    try { updateBadge(); } catch {}
  };
  function updateBadge() {
    const n = logs.filter((l) => l.type === "error").length;
    errEl.textContent = n ? `⚠ ${n}` : "";
    errEl.title = n ? "Errors captured — click to open the Console tab" : "";
  }
  const origConsole = { error: console.error, warn: console.warn };
  const wrapErr = function (...a) { addLog("error", a.map(strOf).join(" ")); return origConsole.error.apply(this, a); };
  const wrapWarn = function (...a) { addLog("warn", a.map(strOf).join(" ")); return origConsole.warn.apply(this, a); };
  console.error = wrapErr;
  console.warn = wrapWarn;
  const onErr = (e) => {
    const t = e.target;
    if (t && t !== window && (t.src || t.href)) addLog("error", "Failed to load " + (t.tagName || "").toLowerCase() + ": " + (t.src || t.href));
    else addLog("error", `${e.message || "Script error"} (${trunc((e.filename || "").split("/").pop(), 40)}:${e.lineno || 0})`);
  };
  const onRej = (e) => addLog("error", "Unhandled promise rejection: " + strOf(e.reason));
  window.addEventListener("error", onErr, true);
  window.addEventListener("unhandledrejection", onRej);

  // Run JavaScript from the Console tab
  const replLog = [];
  const runJS = (code) => {
    const push = (text, level) => { replLog.push({ text, level }); if (replLog.length > 50) replLog.shift(); render(); };
    try {
      if (code.trim().toLowerCase() === "boo") { setSpooky(!spooky.box); return push("👻 Boo!"); }
      const v = (0, eval)(code);
      if (v && typeof v.then === "function") {
        v.then((r) => push(`› ${code}\n  (resolved) ${trunc(strOf(r), 500)}`), (e) => push(`› ${code}\n  (rejected) ${trunc(strOf(e), 500)}`, "bad"));
        push(`› ${code}\n  Promise {pending}`);
      } else push(`› ${code}\n  ${v === undefined ? "undefined" : trunc(typeof v === "function" ? String(v) : strOf(v), 500)}`);
    } catch (e) { push(`› ${code}\n  ${e && e.message ? e.message : e}`, "bad"); }
  };

  // Live network log (non-invasive: uses PerformanceObserver, no fetch/XHR patching)
  const netLog = [];
  observe("resource", (e) => { netLog.push(e); if (netLog.length > 500) netLog.shift(); });

  // Element picker
  let picking = false, picked = null;
  const overlay = document.createElement("div");
  const setOverlay = (el) => {
    if (!el || !el.getBoundingClientRect) { overlay.style.cssText = "display:none"; return; }
    const r = el.getBoundingClientRect();
    overlay.style.cssText = `position:fixed;pointer-events:none;z-index:2147483646;border:2px solid #4ea1ff;background:rgba(78,161,255,.22);left:${r.left}px;top:${r.top}px;width:${r.width}px;height:${r.height}px;`;
  };
  const inPanel = (e) => e.composedPath().includes(host);
  const swallow = (e) => { if (inPanel(e)) return; e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation(); };
  const onMove = (e) => { if (!inPanel(e)) setOverlay(e.target); };
  const onPickClick = (e) => {
    if (inPanel(e)) return;
    swallow(e);
    picked = e.target;
    setPicking(false);
    current = "Inspect";
    render();
  };
  function setPicking(on) {
    if (on === picking) return;
    picking = on;
    const fn = on ? "addEventListener" : "removeEventListener";
    document[fn]("mousemove", onMove, true);
    document[fn]("click", onPickClick, true);
    ["mousedown", "mouseup", "pointerdown", "pointerup"].forEach((t) => document[fn](t, swallow, true));
    if (on) { overlay.style.cssText = "display:none"; if (!overlay.isConnected) document.documentElement.appendChild(overlay); }
    else setOverlay(null);
    pickBtn.classList.toggle("on", on);
    flash(on ? "Click an element on the page (Esc to cancel)" : "Picker off");
    draw();
  }

  // Internal link checker
  let linkCheck = null;
  async function runLinkCheck() {
    if (linkCheck && linkCheck.running) return;
    const urls = [...new Set([...document.links]
      .filter((a) => a.hostname === location.hostname && /^https?:$/.test(a.protocol))
      .map((a) => a.href.split("#")[0]))].slice(0, 60);
    linkCheck = { running: true, done: 0, total: urls.length, ok: 0, bad: [] };
    let i = 0;
    const worker = async () => {
      while (i < urls.length) {
        const u = urls[i++];
        try {
          let r = await fetch(u, { method: "HEAD", credentials: "same-origin", cache: "no-store" });
          if (r.status === 405 || r.status === 501) r = await fetch(u, { method: "GET", credentials: "same-origin", cache: "no-store" });
          if (r.status >= 400) linkCheck.bad.push({ text: `${r.status}  ${u}`, level: "bad" }); else linkCheck.ok++;
        } catch { linkCheck.bad.push({ text: `ERR  ${u}`, level: "bad" }); }
        linkCheck.done++;
        flash(`Checking links ${linkCheck.done}/${linkCheck.total}`);
      }
    };
    flash(`Checking ${urls.length} links…`);
    await Promise.all([worker(), worker(), worker(), worker()]);
    linkCheck.running = false;
    render();
  }

  // Exports, docking, cookie cleanup
  const toMarkdown = (tabs) => {
    let o = `# InfoSo report\n\n- URL: ${location.href}\n- Generated: ${new Date().toISOString()}\n`;
    for (const [tab, secs] of Object.entries(toPlain(tabs))) {
      o += `\n## ${tab}\n`;
      for (const [title, data] of Object.entries(secs)) {
        o += `\n### ${title}\n\n`;
        if (Array.isArray(data)) o += data.length ? data.map((x) => `- ${x}`).join("\n") + "\n" : "_None_\n";
        else o += Object.entries(data).map(([k, v]) => `- **${k}:** ${v}`).join("\n") + "\n";
      }
    }
    return o;
  };
  const downloadFile = (name, text, type) => {
    try {
      const a = document.createElement("a");
      a.href = URL.createObjectURL(new Blob([text], { type }));
      a.download = name;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 2000);
      flash("Downloaded");
    } catch { flash("Download blocked"); }
  };
  const dock = (c) => {
    const r = host.getBoundingClientRect(), m = 12;
    host.style.left = (c.includes("r") ? Math.max(0, innerWidth - r.width - m) : m) + "px";
    host.style.top = (c.includes("b") ? Math.max(0, innerHeight - r.height - m) : m) + "px";
  };
  const delCookies = () => {
    document.cookie.split(";").forEach((c) => {
      const n = c.split("=")[0].trim();
      if (!n) return;
      ["", "; domain=" + location.hostname, "; domain=." + location.hostname].forEach((dom) => {
        document.cookie = `${n}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/${dom}`;
      });
    });
  };

  // 🎃 Spooky page overlay: ghosts, bats, pumpkins drifting across the page (pointer-events: none)
  const spooky = { box: null, sheet: null };
  const setSpooky = (on) => {
    try {
      if (on && !spooky.box) {
        const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const s = new CSSStyleSheet();
        s.replaceSync("@keyframes infoso-drift{0%,100%{transform:translate(0,0) rotate(0)}50%{transform:translate(40px,-30px) rotate(8deg)}}@keyframes infoso-pagefly{from{transform:translateX(-10vw)}to{transform:translateX(110vw)}}");
        document.adoptedStyleSheets = [...document.adoptedStyleSheets, s];
        spooky.sheet = s;
        const box = document.createElement("div");
        box.style.cssText = "position:fixed;left:0;top:0;right:0;bottom:0;pointer-events:none;z-index:2147483645;overflow:hidden;";
        ["👻", "🦇", "🎃", "🕷️", "💀", "🦇", "👻", "🎃", "🦇", "🕸️"].forEach((ic, i) => {
          const e = document.createElement("span");
          e.textContent = ic;
          const bat = ic === "🦇";
          let css = `position:absolute;top:${6 + ((i * 37) % 80)}vh;left:${bat ? 0 : 4 + ((i * 29) % 88)}vw;font-size:${22 + (i % 3) * 10}px;opacity:.85;`;
          if (!calm) css += bat ? `animation:infoso-pagefly ${10 + i * 2}s linear infinite ${i}s;` : `animation:infoso-drift ${4 + (i % 4)}s ease-in-out infinite ${(i * 0.4).toFixed(1)}s;`;
          e.style.cssText = css;
          box.appendChild(e);
        });
        document.documentElement.appendChild(box);
        spooky.box = box;
        flash("👻 Boo!");
      } else if (!on && spooky.box) {
        spooky.box.remove(); spooky.box = null;
        document.adoptedStyleSheets = document.adoptedStyleSheets.filter((x) => x !== spooky.sheet);
      }
    } catch { flash("Blocked by page"); }
  };

  // Eyedropper (Chrome): pick any pixel on screen
  const pickedColors = [];
  const eyedrop = async () => {
    if (!("EyeDropper" in window)) { flash("EyeDropper not supported here"); return; }
    try {
      const r = await new EyeDropper().open();
      pickedColors.unshift({ c: r.sRGBHex, n: 1 });
      if (pickedColors.length > 20) pickedColors.pop();
      copy(r.sRGBHex);
      render();
    } catch {}
  };

  const detectTech = (scriptSrcs, sheetHrefs) => {
    const d = document, w = window, found = [];
    const add = (name, ver) => found.push(ver ? `${name} ${ver}` : name);
    const srcHas = (re) => scriptSrcs.some((s) => re.test(s)) || sheetHrefs.some((s) => re.test(s));
    const root = d.getElementById("root") || d.getElementById("app") || d.getElementById("__next");

    if (w.React || d.querySelector("[data-reactroot]") || (root && Object.keys(root).some((k) => k.startsWith("__reactContainer") || k.startsWith("_reactRoot")))) add("React", safe(() => w.React.version, ""));
    if (w.__NEXT_DATA__ || d.getElementById("__next")) add("Next.js");
    if (w.Vue || w.__VUE__ || d.querySelector("[data-v-app]")) add("Vue", safe(() => w.Vue.version, ""));
    if (w.__NUXT__ || w.$nuxt) add("Nuxt");
    if (w.ng || d.querySelector("[ng-version]")) add("Angular", d.querySelector("[ng-version]")?.getAttribute("ng-version") || "");
    if (w.angular) add("AngularJS", safe(() => w.angular.version.full, ""));
    if (d.querySelector('[class*="svelte-"]')) add("Svelte");
    if (w.Alpine) add("Alpine.js", safe(() => w.Alpine.version, ""));
    if (w.htmx) add("htmx");
    if (d.getElementById("___gatsby")) add("Gatsby");
    if (w.jQuery) add("jQuery", safe(() => w.jQuery.fn.jquery, ""));
    if (w._ && w._.VERSION) add("Lodash", w._.VERSION);
    if (w.THREE) add("Three.js", safe(() => w.THREE.REVISION, ""));
    if (w.bootstrap || srcHas(/bootstrap/i)) add("Bootstrap");
    if (srcHas(/tailwind/i)) add("Tailwind CSS");
    if (srcHas(/font-?awesome|fontawesome/i)) add("Font Awesome");
    if (w.Shopify) add("Shopify");
    if (d.querySelector('meta[name="generator"][content*="WordPress" i]') || srcHas(/wp-content|wp-includes/i)) add("WordPress");
    if (w.Drupal) add("Drupal");
    if (w.wixBiSession || srcHas(/wixstatic/i)) add("Wix");
    if (srcHas(/squarespace/i)) add("Squarespace");
    if (w.gtag || w.ga || w.dataLayer || srcHas(/google-analytics|googletagmanager/i)) add("Google Analytics / GTM");
    if (srcHas(/connect\.facebook\.net|fbevents/i)) add("Facebook Pixel");
    if (srcHas(/cloudflare/i)) add("Cloudflare (scripts)");
    if (srcHas(/stripe\.com/i)) add("Stripe");
    if (srcHas(/recaptcha|hcaptcha/i)) add("CAPTCHA");
    const gen = d.querySelector('meta[name="generator"]')?.content;
    if (gen) add("Generator: " + gen);
    return found;
  };

  // ───────────────────────── headers cache ─────────────────────────
  let headersCache = null;
  let headersError = null;
  const fetchHeaders = async () => {
    headersError = null;
    try {
      const r = await fetch(location.href, { method: "HEAD", cache: "no-store", credentials: "same-origin" });
      headersCache = { status: `${r.status} ${r.statusText}`.trim(), headers: Object.fromEntries(r.headers.entries()) };
    } catch (e) {
      headersError = String(e && e.message ? e.message : e);
    }
    await render();
  };

  // ───────────────────────── data collection ─────────────────────────
  const collect = async () => {
    const d = document;
    const nav = performance.getEntriesByType("navigation")[0];
    const res = performance.getEntriesByType("resource");
    const all = [...d.getElementsByTagName("*")];
    const meta = (n) => d.querySelector(`meta[name="${n}" i], meta[property="${n}" i]`)?.content?.trim() || null;
    const na = (v) => (v === null || v === undefined || v === "" ? "N/A" : v);
    const hostname = location.hostname;
    const hostOf = (u) => safe(() => new URL(u, location.href).hostname, "");

    // DOM depth
    const depthMap = new Map(); let maxDepth = 0;
    for (const el of all) {
      const p = el.parentElement;
      const dep = p ? (depthMap.get(p) || 0) + 1 : 1;
      depthMap.set(el, dep);
      if (dep > maxDepth) maxDepth = dep;
    }

    const bodyText = d.body?.innerText || "";
    const words = bodyText.trim().split(/\s+/).filter(Boolean).length;
    const stop = new Set("the and for that with this from your are you not have was but can all our out has will more about they their which when what there been one would into than them its also other how who any may use new get just like over only such some time these see his her she him were had does did here then very each much many most make made well need want your".split(" "));
    const freq = {};
    (bodyText.toLowerCase().match(/[a-z][a-z'-]{3,}/g) || []).forEach((w) => { if (!stop.has(w)) freq[w] = (freq[w] || 0) + 1; });
    const topWords = Object.entries(freq).sort((a, b) => b[1] - a[1]).slice(0, 15).map(([w, n]) => `${w}  ×${n}`);
    const scripts = [...d.scripts];
    const scriptSrcs = scripts.map((s) => s.src).filter(Boolean);
    const sheetHrefs = [...d.querySelectorAll('link[rel~="stylesheet" i]')].map((l) => l.href).filter(Boolean);
    const inlineScripts = scripts.filter((s) => !s.src).length;
    const inlineStyles = d.querySelectorAll("style").length;

    // Resources
    const groups = {};
    res.forEach((r) => {
      const t = r.initiatorType || "other";
      const g = (groups[t] = groups[t] || { n: 0, size: 0 });
      g.n++; g.size += r.transferSize || 0;
    });
    const totalTransfer = res.reduce((a, r) => a + (r.transferSize || 0), 0) + (nav?.transferSize || 0);
    const resDomains = {};
    res.forEach((r) => { const h = hostOf(r.name); if (h) resDomains[h] = (resDomains[h] || 0) + 1; });
    const domainList = Object.entries(resDomains).sort((a, b) => b[1] - a[1]);
    const externalDomains = domainList.filter(([h]) => h !== hostname);
    const slowest = [...res].sort((a, b) => b.duration - a.duration).slice(0, 8)
      .map((r) => `${Math.round(r.duration)} ms — ${trunc(r.name, 70)}`);
    const biggest = [...res].filter((r) => r.transferSize).sort((a, b) => b.transferSize - a.transferSize).slice(0, 8)
      .map((r) => `${fmtBytes(r.transferSize)} — ${trunc(r.name, 70)}`);

    // Links
    const links = [...d.links];
    let internal = 0, external = 0, mail = 0, tel = 0, nofollow = 0, blank = 0, unsafeBlank = 0, empty = 0;
    const extHosts = {}; const emails = new Set(); const phones = new Set();
    const socialRe = /(twitter\.com|x\.com|facebook\.com|instagram\.com|linkedin\.com|youtube\.com|youtu\.be|github\.com|tiktok\.com|discord\.(gg|com)|reddit\.com|twitch\.tv|t\.me)/i;
    const social = new Set();
    links.forEach((a) => {
      const href = (a.getAttribute("href") || "").trim();
      if (a.protocol === "mailto:") { mail++; emails.add(href.replace(/^mailto:/i, "").split("?")[0]); return; }
      if (a.protocol === "tel:") { tel++; phones.add(href.replace(/^tel:/i, "")); return; }
      if (!href || href === "#") empty++;
      if (a.hostname && a.hostname === hostname) internal++;
      else if (a.hostname) { external++; extHosts[a.hostname] = (extHosts[a.hostname] || 0) + 1; if (socialRe.test(a.hostname)) social.add(a.href); }
      if (/nofollow/i.test(a.rel)) nofollow++;
      if (a.target === "_blank") { blank++; if (!/noopener|noreferrer/i.test(a.rel)) unsafeBlank++; }
    });

    // Images
    const imgs = [...d.images];
    const noAlt = imgs.filter((i) => !i.hasAttribute("alt"));
    const lazy = imgs.filter((i) => i.loading === "lazy").length;
    const bigImgs = imgs.filter((i) => i.naturalWidth)
      .sort((a, b) => b.naturalWidth * b.naturalHeight - a.naturalWidth * a.naturalHeight).slice(0, 5)
      .map((i) => `${i.naturalWidth}×${i.naturalHeight} — ${trunc(i.currentSrc || i.src, 70)}`);

    // Headings
    const hs = [...d.querySelectorAll("h1,h2,h3,h4,h5,h6")];
    const h1count = hs.filter((x) => x.tagName === "H1").length;
    const outline = hs.slice(0, 80).map((x) => "  ".repeat(+x.tagName[1] - 1) + x.tagName + "  " + trunc(x.textContent.trim().replace(/\s+/g, " "), 70));

    // Forms
    const forms = [...d.forms].map((f) => `${(f.method || "get").toUpperCase()} ${trunc(f.getAttribute("action") || "(same page)", 50)} — ${f.elements.length} fields`);
    const pwInputs = d.querySelectorAll('input[type="password"]');

    // Storage
    const lsKeys = safe(() => Object.keys(localStorage), null);
    const ssKeys = safe(() => Object.keys(sessionStorage), null);
    const sizeOf = (store, keys) => keys ? keys.map((k) => `${k}  (${fmtBytes((k.length + (store.getItem(k) || "").length) * 2)})`) : [];
    const cookies = d.cookie ? d.cookie.split(";").map((c) => c.trim()).filter(Boolean).map((c) => { const i = c.indexOf("="); return `${c.slice(0, i)} = ${trunc(c.slice(i + 1), 40)}`; }) : [];
    const cookieItems = (await asafe(async () => (await cookieStore.getAll()).map((c) => ({
      text: `${c.name} = ${trunc(c.value, 30)}   [${c.secure ? "Secure" : "not Secure"}, SameSite=${c.sameSite || "?"}, ${c.expires ? "exp " + new Date(c.expires).toLocaleDateString() : "session"}]`,
      level: !c.secure && location.protocol === "https:" ? "warn" : undefined,
